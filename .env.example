# ==============================================================================
# InvestFlow - Environment Configuration Template
# Copy this file to .env before running Docker Compose or local microservices
# ==============================================================================

# Database Configuration (Microsoft SQL Server 2022)
MSSQL_SA_PASSWORD=YourStrongSA_Password123!
MSSQL_PORT=1433
DB_HOST=localhost
DB_USER=investflow_app
DB_PASSWORD=YourSecureAppPassword123!

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YourSecureRedisPassword123!

# JWT Security Configuration
JWT_SECRET=YourSuperSecretKeyMustBeAtLeast256BitsLongForHMACSHA384
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Microservice Ports
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
PORTFOLIO_SERVICE_PORT=8082
INVESTMENT_SERVICE_PORT=8083
ANALYTICS_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
AI_SERVICE_PORT=8086
XIRR_SERVICE_PORT=8005

# Real-time and Python Service URLs
XIRR_SERVICE_URL=http://localhost:8005
XIRR_WS_URL=ws://localhost:8005/ws/xirr

# AI & LLM Service Configuration
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Frontend & NGINX
FRONTEND_PORT=4200
NGINX_PORT=80
NGINX_SSL_PORT=443
